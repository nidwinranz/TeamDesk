# ---------------------------------------------------------------------------
# TeamDesk environment variables. Copy to `.env` for local development.
# Every variable is validated at startup by server/lib/env.ts.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production.
NODE_ENV=development

# Public base URL of the app (used in emails, Stripe redirects, OAuth callbacks).
APP_URL=http://localhost:3000

# --- Database (PostgreSQL 16) ----------------------------------------------
# Pooled connection string used by the app at runtime (Neon: the "-pooler" host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamdesk
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamdesk
# Separate database used by integration tests (it is wiped on every run).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamdesk_test

# --- Redis (rate limiting) --------------------------------------------------
# Redis protocol URL. Upstash: use the `rediss://default:<password>@<host>:6379` URL.
REDIS_URL=redis://localhost:6379

# --- Auth.js -----------------------------------------------------------------
# Secret used to sign/encrypt session JWTs. Generate with `openssl rand -base64 32`.
AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Trust the Host header (required behind Vercel / proxies). Keep `true`.
AUTH_TRUST_HOST=true
# Google OAuth client (https://console.cloud.google.com/apis/credentials). Leave blank to hide the button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email ---------------------------------------------------------------------
# Sender address for all transactional email.
EMAIL_FROM="TeamDesk <no-reply@teamdesk.local>"
# Resend API key (production). When blank, SMTP below is used (Mailpit locally).
RESEND_API_KEY=
# SMTP host/port for local email capture (Mailpit UI: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Stripe (test mode) ------------------------------------------------------
# `live` uses the real Stripe API; `mock` uses a local fake checkout (dev/E2E only, never in production).
BILLING_MODE=mock
# Allows BILLING_MODE=mock in a production build (CI E2E only). Never `true` on a real deployment.
ALLOW_MOCK_BILLING=false
# Secret key from https://dashboard.stripe.com/test/apikeys (sk_test_...).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Locally: printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_local_development_secret
# Price ID of the PRO monthly plan (price_...).
STRIPE_PRO_PRICE_ID=price_pro_monthly_mock

# --- Observability ---------------------------------------------------------
# pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Sentry DSN for server + client error reporting. Blank disables Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source-map upload (CI/Vercel build only). Blank skips upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Demo mode ---------------------------------------------------------------
# When `true`, the login page shows the demo credentials and `pnpm demo:reset` is allowed.
DEMO_MODE=false
