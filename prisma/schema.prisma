// TeamDesk data model.
// Tenancy: shared database, shared schema. Every tenant-owned table carries an
// indexed `organizationId`; see docs/adr/0001-tenancy-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ---------------------------------------------------------------------------
// Global (non-tenant) models
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  image           String?
  /// Bumped on password reset to invalidate existing JWT sessions.
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  accounts    Account[]
  authTokens  AuthToken[]
  assigned    Request[]    @relation("RequestAssignee")
  createdReqs Request[]    @relation("RequestCreator")
  comments    Comment[]
  auditLogs   AuditLog[]
  invitesSent Invite[]     @relation("InviteInviter")
}

/// OAuth account links (e.g. Google). Not part of the original model list; see ADR 0002.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Single-use email verification / password reset tokens. Only the SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  plan             Plan     @default(FREE)
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships  Membership[]
  invites      Invite[]
  subscription Subscription?
  projects     Project[]
  requests     Request[]
  comments     Comment[]
  auditLogs    AuditLog[]
  apiKeys      ApiKey[]
}

/// Stripe webhook dedupe ledger (global: event ids are unique across Stripe).
model WebhookEvent {
  stripeEventId String   @id
  type          String
  processedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Tenant-owned models (all carry organizationId)
// ---------------------------------------------------------------------------

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, email])
}

model Subscription {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  stripeSubscriptionId String   @unique
  status               String
  priceId              String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  /// `created` timestamp of the newest Stripe event applied; older events are ignored.
  lastEventAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Project {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String    @default("")
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     Request[]

  @@index([organizationId])
  @@index([organizationId, archivedAt])
}

model Request {
  id             String          @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String          @default("")
  status         RequestStatus   @default(OPEN)
  priority       RequestPriority @default(MEDIUM)
  assigneeId     String?
  createdById    String?
  dueDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("RequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@index([organizationId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, createdAt, id])
}

model Comment {
  id             String   @id @default(cuid())
  organizationId String
  requestId      String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, requestId, createdAt])
}

/// Append-only: updates/deletes are rejected by the Prisma extension and a DB trigger.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, action, createdAt])
}

/// Modelled now; the API-key feature itself is tracked in docs/TODO.md.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String    @unique
  keyHash        String    @unique
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
